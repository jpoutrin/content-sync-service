# ContentSync Environment Configuration
# This file is loaded automatically by direnv (if installed)

# Load environment from .env.local
if [ -f .env.local ]; then
    dotenv .env.local
fi

# Django port (only in dev mode)
if [ "$DEBUG" = "True" ]; then
    export DJANGO_PORT=$(portman get -q content-sync-service)
fi

# Python virtual environment
export VIRTUAL_ENV=.venv
export PATH="$PWD/.venv/bin:$PATH"
